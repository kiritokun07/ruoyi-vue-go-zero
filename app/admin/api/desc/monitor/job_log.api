syntax = "v1"

type JobLogEntry {
	JobLogId      int64  `json:"jobLogId,optional" db:"job_log_id"`
	JobName       string `json:"jobName,optional" db:"job_name"`
	JobGroup      string `json:"jobGroup,optional" db:"job_group"`
	InvokeTarget  string `json:"invokeTarget,optional" db:"invoke_target"`
	JobMessage    string `json:"jobMessage,optional" db:"job_message"`
	Status        string `json:"status,optional" db:"status"`
	ExceptionInfo string `json:"exceptionInfo,optional" db:"exception_info"`
	CreateTime    string `json:"createTime,optional" db:"create_time"`
}

@server (
	group: job_log
	middleware: Session
)
service admin-api {
	@handler ListJobLog
	get /monitor/jobLog/list (AdminFilter) returns (PageResult)
	@handler GetJobLog
	get /monitor/jobLog/:id (RecordId) returns (Result)
	@handler DeleteJobLog
	delete /monitor/jobLog/:ids (RecordIds) returns (StatusResponse)
	@handler CleanJobLog
	delete /monitor/jobLog/clean returns (StatusResponse)
}

// 导入导出接口独立设置超时，普通接口沿用 go-zero 默认值。
@server (
	group: job_log
	middleware: Session
	timeout: 1m
)
service admin-api {
	@handler ExportJobLog
	post /monitor/jobLog/export (AdminFilter)
}
