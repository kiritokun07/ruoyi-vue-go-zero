syntax = "v1"

type LoginRequest {
	Username string `json:"username,optional" validate:"required,min=2,max=20"`
	Password string `json:"password,optional" validate:"required,min=5,max=20"`
	Code     string `json:"code,optional"`
	Uuid     string `json:"uuid,optional"`
}

type CaptchaResponse {
	Code           int    `json:"code"`
	Msg            string `json:"msg"`
	CaptchaEnabled bool   `json:"captchaEnabled"`
	Uuid           string `json:"uuid,omitempty"`
	Img            string `json:"img,omitempty"`
}

type LoginResponse {
	Code  int    `json:"code"`
	Msg   string `json:"msg"`
	Token string `json:"token"`
}

type InfoResponse {
		StatusResponse
		User               UserProfile `json:"user"`
		Roles              []string    `json:"roles"`
		Permissions        []string    `json:"permissions"`
		IsDefaultModifyPwd bool        `json:"isDefaultModifyPwd"`
		IsPasswordExpired  bool        `json:"isPasswordExpired"`
}

type RouteMeta {
		Title   string `json:"title"`
		Icon    string `json:"icon"`
		NoCache bool   `json:"noCache"`
		Link    string `json:"link,omitempty"`
}

type Route {
		Name       string     `json:"name,omitempty"`
		Path       string     `json:"path"`
		Hidden     bool       `json:"hidden"`
		Component  string     `json:"component,omitempty"`
		Query      string     `json:"query,omitempty"`
		Redirect   string     `json:"redirect,omitempty"`
		AlwaysShow bool       `json:"alwaysShow,omitempty"`
		Meta       *RouteMeta `json:"meta,omitempty"`
		Children   []Route    `json:"children,omitempty"`
}

type RoutersResponse {
		StatusResponse
		Data []Route `json:"data"`
}

@server (
	group: auth
)
service admin-api {
	@handler CaptchaImage
	get /captchaImage returns (CaptchaResponse)
	@handler Logout
	post /logout returns (StatusResponse)
	@handler Login
	post /login (LoginRequest) returns (LoginResponse)
}

@server (
	group: auth
	middleware: Session
)
service admin-api {
	@handler GetInfo
	get /getInfo returns (InfoResponse)
	@handler GetRouters
	get /getRouters returns (RoutersResponse)
}

@server (
	group: auth
)
service admin-api {
	@handler Register
	post /register (LoginRequest) returns (StatusResponse)
}
