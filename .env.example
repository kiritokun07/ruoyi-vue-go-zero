# Local installation defaults. Change passwords and JWT secret before exposing the API.
# Use letters and numbers for these values (a 64-character random hex string is suitable).
RUOYI_BIND_ADDRESS=127.0.0.1
RUOYI_HTTP_PORT=8888
MYSQL_ROOT_PASSWORD=localRootChangeMe2026
MYSQL_PASSWORD=localAppChangeMe2026
RUOYI_JWT_SECRET=localDevelopmentOnlyChangeThisSecretBeforeDeploying2026
# Leave empty for the private Compose network, or set an alphanumeric password.
RUOYI_REDIS_PASSWORD=

# If the default Go proxy is unreachable, uncomment this optional build setting.
# GOPROXY=https://goproxy.cn,direct
