# 默认只启动后端，连接你已有的 MySQL 和 Redis。
# 留空：不启动 MySQL/Redis 容器；mysql：只启用 MySQL；redis：只启用 Redis；mysql,redis：都启用。
COMPOSE_PROFILES=

# 后端对宿主机开放的地址和端口；127.0.0.1 仅本机可访问。
RUOYI_BIND_ADDRESS=127.0.0.1
RUOYI_HTTP_PORT=8888

# 外部数据库连接：请填写实际账号密码，并先按 sql 脚本初始化空库。
# host.docker.internal 表示宿主机；远程数据库请填域名或 IP，不能填容器内的 localhost。
# 启用 mysql profile 时，将 MYSQL_HOST 改为 mysql、MYSQL_PORT 改为 3306。
# 内置 MySQL 会创建下面的数据库和普通账号，MYSQL_USER 不要设置为 root。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue
MYSQL_USER=ruoyi
MYSQL_PASSWORD=localAppChangeMe2026
# 只有启用 MySQL 容器时使用；外部数据库不使用这个配置。
MYSQL_ROOT_PASSWORD=localRootChangeMe2026

# 外部 Redis 地址；启用 redis profile 时改为 redis:6379。
# 密码需与外部服务一致；内置 Redis 则使用此密码启动，留空代表无密码。
RUOYI_REDIS_HOST=host.docker.internal:6379
RUOYI_REDIS_PASSWORD=

# 至少 32 个字符，重启时保持不变；开放访问前替换示例值。
# 密码和密钥建议使用随机字母数字串，例如 openssl rand -hex 32 的输出。
RUOYI_JWT_SECRET=localDevelopmentOnlyChangeThisSecretBeforeDeploying2026

# 仅在默认 Go 依赖源无法访问时启用，不影响镜像下载地址。
# GOPROXY=https://goproxy.cn,direct
